# =========================================================================
# TEST KIMLIK BILGILERI ORNEGI
#
# Bu dosyayi ".env.test" adiyla kopyalayip doldurun. .env.test dosyasi
# .gitignore icinde (.env* kurali) — asla depoya girmez.
#
#   cp .env.test.example .env.test
#
# Sonra `npm test` calisir. Baska hicbir kurulum gerekmez.
# =========================================================================

# Supabase baglantisi — .env.local dosyanizdaki ayni degerler
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Testlerin oturum acacagi hesap
OTOCV_TEST_EMAIL=
OTOCV_TEST_PASSWORD=

# Testlerin okudugu ornek arac (veritabaninda var olmali)
OTOCV_TEST_PLAKA=34ABC123

# Sitenin adresi. Bos ise http://localhost:3000 kullanilir.
OTOCV_TEST_URL=

# OTOCV_TEST_PIN KALDIRILDI
# Testler artık PIN'i sabit tutmuyor. PIN güvenlik gerekçesiyle
# yenilendiğinde bu değer sessizce eskiyor ve 12 test var olmayan bir PIN'e
# gidiyordu. Plaka birincil anahtar ve hiç değişmiyor; PIN'e ihtiyaç duyan
# test onu çalışma anında plakadan çözüyor (yardimcilar.js -> pinBul).

# ⚠ BU DOSYA ÖRNEKTİR VE HERKESE AÇIK DEPODA DURUYOR.
# Buraya ASLA gerçek değer yazmayın. 12-19 Ağustos 2026 arasında bu
# dosyada çalışan bir hesabın gerçek şifresi durdu ve açık depoda yayına
# çıktı. Gerçek değerler yalnızca .gitignore'daki `.env.test` dosyasına
# yazılır.

# İKİNCİ TEST HESABI — devir testleri için
# Devir iki kullanıcı arasında olduğu için ikinci bir hesap şart. Her koşumda
# signUp ile yeni hesap açmak yerine SABİT bir hesap kullanılıyor: anon
# anahtarla auth kullanıcısı SİLİNEMEZ, yani açılan her hesap kalıcı çöp olur.
OTOCV_TEST_EMAIL2=
OTOCV_TEST_PASSWORD2=
