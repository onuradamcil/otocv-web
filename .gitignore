# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ornek dosya depoda kalmali — .env* kurali onu da gizliyordu
!.env.test.example

# playwright ciktilari (ekran goruntuleri, videolar, izler, HTML rapor)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Supabase CLI yerel bag dosyalari. Sifre ICERMIYOR (dogrulandi) ama
# makineye ozgu: proje referansi, pooler adresi ve surum bilgileri.
# Depoda durmalari kimseye yaramaz, karisiklik cikarir.
supabase/.temp/

# Yikici islem oncesi alinan JSON dokumleri. Plaka ve gorsel yollari
# icerir - kisisel veri, depoya GIRMEZ.
yedek/
